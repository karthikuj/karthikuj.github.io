---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sketch from '../components/Sketch.astro';
import SpecimenLabel from '../components/SpecimenLabel.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { SECTIONS, SECTION_IDS, entryUrl, formatDate, getEntries, getSeries } from '../lib/entries';

const permalink = Astro.site?.href ?? '/';
const all = await getEntries();
const latest = SECTION_IDS.map((id) => ({ id, item: all.find((i) => i.entry.data.section === id) }));

const seriesNames = [...new Set(all.map((i) => i.entry.data.series).filter((s): s is string => Boolean(s)))];
const series = await Promise.all(seriesNames.map(async (name) => ({ name, parts: await getSeries(name) })));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} permalink={permalink} current="home">
	<section class="intro">
		<div class="intro-copy">
			<h1 class="page-title">Hi, I am Karthik</h1>
			<p class="lede">
				I am a software engineer at <a href="https://www.phonepe.com/" rel="noopener">PhonePe</a>. Outside work I dig into
				security, and right now that means Windows internals: how kernel objects are built, how they are secured, and
				how those defences fail.
			</p>
			<p class="lede">
				This site holds my field notes: long write-ups you can reproduce with a debugger, write-ups of the tools I build,
				and my vulnerability research.
			</p>
		</div>

		<div class="portrait">
			<Sketch id="author-at-laptop" label="Pencil sketch of Karthik in a hoodie, smiling and typing on a laptop" />
		</div>
	</section>

	<section class="latest" aria-labelledby="latest-title">
		<h2 id="latest-title" class="block-title">Latest plates</h2>
		<ol>
			{
				latest.map(({ id, item }) => (
					<li class="latest-row" data-section={id}>
						<a class="sect" href={`${SECTIONS[id].base}/`}>
							<span class="dye-mark" />
							{SECTIONS[id].label}
						</a>
						{item ? (
							<>
								<a class="title" href={entryUrl(item.entry)}>
									{item.entry.data.title}
								</a>
								<span class="when">{formatDate(item.entry.data.publishDate)}</span>
								<span class="plate">Plate {item.plate}</span>
							</>
						) : (
							<span class="none">{SECTIONS[id].empty}</span>
						)}
					</li>
				))
			}
		</ol>
	</section>

	{
		series.length > 0 && (
			<section class="series" aria-labelledby="series-title">
				<h2 id="series-title" class="block-title">
					Series
				</h2>
				{series.map((s) => (
					<SpecimenLabel class="series-label" left={s.name} right={`${s.parts.length} parts`}>
						{s.parts.map((p) => (
							<>
								<dt class="label-key">Part {p.data.part}</dt>
								<dd>
									{p.data.draft ? (
										<span class="pending">In progress</span>
									) : (
										<a href={entryUrl(p)}>{p.data.title}</a>
									)}
								</dd>
							</>
						))}
					</SpecimenLabel>
				))}
			</section>
		)
	}
</BaseLayout>

<style>
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
		gap: 4rem;
		align-items: start;
		padding-top: 1rem;
	}

	.lede {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 56ch;
		margin-top: 1.25rem;
	}

	.lede:first-of-type {
		margin-top: 1.75rem;
	}

	.portrait {
		max-width: 420px;
		width: 100%;
		justify-self: end;
		margin-top: -0.5rem;
	}

	.block-title {
		font-size: 1.5rem;
		font-stretch: 105%;
		padding-bottom: 0.6rem;
		border-bottom: 2px solid var(--ink);
	}

	.latest {
		margin-top: 4.5rem;
		max-width: 1080px;
	}

	.latest ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.latest-row {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr) auto 5rem;
		align-items: baseline;
		gap: 1.5rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--rule);
		font-family: var(--font-frame);
	}

	.sect {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--dye);
	}

	.title {
		font-size: 1.125rem;
		font-weight: 700;
		text-decoration: none;
	}

	.title:hover {
		text-decoration: underline;
	}

	.when,
	.plate {
		font-size: 0.875rem;
		color: var(--pencil);
		font-variant-numeric: tabular-nums;
	}

	.plate {
		text-align: right;
	}

	.none {
		grid-column: 2 / -1;
		font-family: var(--font-read);
		font-style: italic;
		color: var(--pencil);
	}

	.series {
		margin-top: 4.5rem;
		max-width: 1080px;
	}

	.series :global(.series-label) {
		margin-top: 1.5rem;
		max-width: 560px;
	}

	.series :global(dl) {
		grid-template-columns: 4.5rem minmax(0, 1fr);
	}

	.pending {
		font-style: italic;
		color: var(--pencil);
	}

	@media (max-width: 960px) {
		.intro {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
		}

		.portrait {
			max-width: 320px;
			justify-self: start;
			margin-top: 0;
		}
	}

	@media (max-width: 640px) {
		.latest-row {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.35rem 1rem;
		}

		.sect {
			grid-column: 1 / -1;
		}

		.title {
			grid-column: 1 / -1;
		}

		.plate {
			text-align: right;
		}

		.lede {
			font-size: 1.125rem;
		}
	}
</style>
