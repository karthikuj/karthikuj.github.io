---
import { SITE_TITLE } from '../consts';
---

<footer>
	<span>&copy; {new Date().getFullYear()} {SITE_TITLE}</span>
	<span class="links">
		<a href="/rss.xml">RSS</a>
		<a href="https://github.com/karthikuj" rel="noopener">GitHub</a>
		<span>Built with <a href="https://astro.build" rel="noopener">Astro</a></span>
	</span>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding: 1.4rem 0 2rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-frame);
		font-size: 0.875rem;
		color: var(--pencil);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.4rem;
	}

	a {
		color: var(--ink-soft);
	}
</style>
