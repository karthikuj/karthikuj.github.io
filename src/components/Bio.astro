---
// Author note at the end of every entry.
import Sketch from './Sketch.astro';
---

<aside class="bio" aria-label="About the author">
	<div class="avatar">
		<Sketch id="author-avatar" label="Pencil sketch of Karthik" />
	</div>
	<p>
		Written by <strong>Karthik</strong>, a software engineer at PhonePe who spends personal time on security, currently
		Windows security. More on the <a href="/about/">about</a> page, or browse the <a href="/blog/">writing</a>.
	</p>
</aside>

<style>
	.bio {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	.avatar {
		width: 72px;
		height: 72px;
		flex: none;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--rule);
		background: var(--sketch-paper);
	}

	p {
		font-size: 1rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}
</style>
