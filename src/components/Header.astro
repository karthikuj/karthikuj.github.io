---
// Masthead: wordmark, About, Search and the theme toggle.
// Section navigation (Writing, Projects, Research) lives in the thumb tabs, not here.
import ThemeToggleButton from './ThemeToggleButton.svelte';

const { current = 'home' } = Astro.props;

const links = [
	{ id: 'about', label: 'About', href: '/about/' },
	{ id: 'search', label: 'Search', href: '/search/' },
];
---

<header class="masthead">
	<a class="wordmark" href="/" aria-label="Karthik's blog, home">
		<img src="/assets/logo.webp" alt="" width="54" height="36" />
		<span class="name">Karthik's blog</span>
	</a>
	<nav aria-label="Site">
		<ul>
			{
				links.map((l) => (
					<li>
						<a href={l.href} class:list={[{ on: current === l.id }]} aria-current={current === l.id ? 'page' : undefined}>
							{l.id === 'search' && (
								<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
									<circle cx="7" cy="7" r="4.6" />
									<path d="M10.5 10.5 14 14" />
								</svg>
							)}
							<span class:list={['label', { 'icon-only-narrow': l.id === 'search' }]}>{l.label}</span>
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="toggle">
		<ThemeToggleButton client:load />
	</div>
</header>

<style>
	.masthead {
		display: flex;
		align-items: center;
		gap: 1rem 1.75rem;
		padding: 1.4rem 0 1.25rem;
		border-bottom: 1px solid var(--rule);
	}

	.wordmark {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		min-width: 0;
	}

	.wordmark img {
		width: 40px;
		height: auto;
		flex: none;
	}

	.name {
		font-family: var(--font-frame);
		font-weight: 800;
		font-stretch: 112%;
		font-size: 1.2rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.wordmark:hover {
		color: var(--ink);
	}

	nav {
		margin-left: auto;
	}

	.toggle {
		display: flex;
	}

	ul {
		display: flex;
		align-items: center;
		gap: 1.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-frame);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ink-soft);
		text-decoration: none;
		padding: 0.35rem 0;
		border-bottom: 2px solid transparent;
		white-space: nowrap;
	}

	nav a:hover {
		color: var(--ink);
		border-bottom-color: var(--rule-strong);
	}

	nav a.on {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	@media (max-width: 760px) {
		.masthead {
			padding: 1rem 0 0.9rem;
			gap: 0.75rem 1rem;
		}

		.wordmark img {
			width: 34px;
		}

		.name {
			font-size: 1.05rem;
		}

		ul {
			gap: 1rem;
		}
	}

	@media (max-width: 420px) {
		/* Keep one row on small phones: Search shows only its icon; the label stays for screen readers. */
		.icon-only-narrow {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}

		nav a:has(.icon-only-narrow) {
			padding: 0.35rem 0.25rem;
		}
	}
</style>
