---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ThumbTabs from '../components/ThumbTabs.astro';
import Footer from '../components/Footer.astro';
import type { SectionId } from '../lib/entries';

export interface Props {
	title: string;
	description: string;
	permalink: string;
	/** Which nav item is active. */
	current?: SectionId | 'about' | 'search' | 'home';
	image?: string;
}

const { title, description, permalink, current = 'home', image } = Astro.props;
const section = current === 'writing' || current === 'projects' || current === 'research' ? current : undefined;
---

<html lang="en" data-section={section}>
	<head>
		<BaseHead title={title} description={description} permalink={permalink} image={image} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<ThumbTabs current={section} />
		<div class="frame">
			<Header current={current} />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.frame {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 72px 0 48px;
	}

	main {
		flex: 1;
		padding: 3rem 0 5rem;
	}

	/* Keyboard-only: fully clipped until it receives focus, so no edge can peek in at any font size or zoom. */
	.skip:not(:focus) {
		clip-path: inset(50%);
		width: 1px;
		height: 1px;
		overflow: hidden;
		white-space: nowrap;
		padding: 0;
	}

	.skip {
		position: absolute;
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--ink);
		color: var(--board);
		font-family: var(--font-frame);
		font-weight: 600;
		padding: 0.5rem 0.9rem;
		border-radius: 3px;
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.frame {
			padding: 0 var(--gutter);
		}

		main {
			padding: 2rem 0 4rem;
		}
	}
</style>
